<Window x:Class="DMADC.Views.ConfigWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="采集方案配置" Height="640" Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 基本信息 -->
        <GroupBox Grid.Row="0" Header="目标应用" Padding="12">
            <UniformGrid Columns="2">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="方案名称：" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSchemeName" Width="240"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="窗口标题模式：" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTitlePattern" Width="240" ToolTip="支持 * 通配符，如 '*.exe'"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="窗口类名（可选）：" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtClassName" Width="240"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <CheckBox x:Name="ChkEnabled" Content="启用此方案" IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <!-- 控件规则列表 -->
        <GroupBox Grid.Row="1" Header="控件采集规则" Padding="8" Margin="0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnPick"  Content="拾取控件（十字光标）" Width="170" Height="28" Margin="0,0,8,0" Click="BtnPick_Click"/>
                    <Button x:Name="BtnAdd"  Content="手动添加规则" Width="120" Height="28" Margin="0,0,8,0" Click="BtnAddRule_Click"/>
                    <Button x:Name="BtnEdit" Content="编辑规则" Width="90" Height="28" Margin="0,0,8,0" Click="BtnEditRule_Click"/>
                    <Button x:Name="BtnDel"  Content="删除规则" Width="90" Height="28" Click="BtnDelRule_Click"/>
                </StackPanel>
                <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="控件名" Binding="{Binding DisplayName}" Width="140"/>
                        <DataGridTextColumn Header="定位方式" Binding="{Binding AutomationId}" Width="140"/>
                        <DataGridTextColumn Header="AutomationId" Binding="{Binding AutomationId}" Width="140"/>
                        <DataGridTextColumn Header="ClassName+Name" Binding="{Binding ClassName}" Width="120"/>
                        <DataGridCheckBoxColumn Header="采文本" Binding="{Binding CollectText}" Width="60"/>
                        <DataGridCheckBoxColumn Header="采启用" Binding="{Binding CollectEnabledState}" Width="60"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="30" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存方案" Width="110" Height="30" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
