<Window x:Class="DMADC.Views.ControlPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="控件拾取器" Height="380" Width="520"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="BtnStartPick" Content="🏹 开始拾取 (F1)" Width="160" Height="32" Margin="0,0,12,0" Click="BtnStartPick_Click"/>
            <TextBlock x:Name="HintText" Text="点击开始拾取，然后移动十字光标到目标控件上" VerticalAlignment="Center"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="当前控件信息" Padding="8" Margin="0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="AutomationId：" Foreground="Gray"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAutomationId" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="ClassName：" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtClassName" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="2" Text="Name (Text)：" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtName" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="3" Text="IsEnabled：" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtEnabled" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="4" Text="Process：" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtProcess" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="5" Text="Bounds：" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtBounds" Margin="0,4,0,0"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消 (Esc)" Width="100" Height="30" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnConfirm" Content="✅ 确认添加" Width="120" Height="30" Click="BtnConfirm_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
