<UserControl x:Class="DMADC.Views.LiveViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="实时数据查看" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock x:Name="HintText" Text="（采集中会自动刷新；停止时可查看最后快照）"
                       Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnRefresh" Content="刷新" Width="70" Height="26" Margin="auto,0,8,0" Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="LiveGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  IsSynchronizedWithCurrentItem="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="控件" Binding="{Binding RuleName}" Width="140"/>
                <DataGridTextColumn Header="文本" Binding="{Binding Text, TargetNullValue='—'}" Width="200"/>
                <DataGridTextColumn Header="启用" Binding="{Binding IsEnabled, TargetNullValue='—'}" Width="60"/>
                <DataGridTextColumn Header="可见" Binding="{Binding IsVisible, TargetNullValue='—'}" Width="60"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80"/>
                <DataGridTextColumn Header="采集时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
