<Window x:Class="DMADC.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMADC - Windows 数据采集监控"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：运行控制 -->
        <Border Grid.Row="0" Padding="12" Background="#F3F3F3" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollecting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Fill" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="状态：已停止" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="LastMessageText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnStart" Content="开始采集" Width="100" Height="32" Margin="0,0,8,0" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop"  Content="停止采集" Width="100" Height="32" Click="BtnStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab 导航 -->
        <TabControl Grid.Row="1" Margin="0,12,0,12" Height="Auto">
            <TabItem Header="采集方案">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="SchemeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="方案名" Binding="{Binding SchemeName}" Width="*"/>
                            <DataGridTextColumn Header="窗口标题模式" Binding="{Binding WindowTitlePattern}" Width="180"/>
                            <DataGridTextColumn Header="类名" Binding="{Binding WindowClassName}" Width="120"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="60"/>
                            <DataGridCheckBoxColumn Header="激活" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="新建方案" Width="90" Height="28" Margin="0,0,8,0" Click="BtnNewScheme_Click"/>
                        <Button Content="编辑方案" Width="90" Height="28" Margin="0,0,8,0" Click="BtnEditScheme_Click"/>
                        <Button Content="删除方案" Width="90" Height="28" Margin="0,0,8,0" Click="BtnDeleteScheme_Click"/>
                        <Button Content="激活此方案" Width="100" Height="28" Click="BtnActivateScheme_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="系统设置">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource Header}">密码保护</TextBlock>
                    <CheckBox x:Name="ChkRequirePwd" Content="打开应用时需要密码" Margin="0,4,0,4"/>
                    <Button Content="设置/修改密码" Width="140" Height="32" HorizontalAlignment="Left" Click="BtnChangePwd_Click"/>

                    <TextBlock Style="{StaticResource Header}">开机自启</TextBlock>
                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动 DMADC" Margin="0,4,0,4"/>

                    <TextBlock Style="{StaticResource Header}">采集参数（全局）</TextBlock>
                    <UniformGrid Columns="2" Margin="0,4,0,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="轮询间隔 (毫秒)：" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPollingMs" Width="80" Margin="4,0,0,0" Text="1000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="心跳间隔 (秒)：" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHeartbeatSec" Width="80" Margin="4,0,0,0" Text="30"/>
                        </StackPanel>
                    </UniformGrid>
                    <Button Content="保存系统设置" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnSaveSettings_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="实时数据">
                <Frame x:Name="LiveFrame" NavigationUIVisibility="Hidden" Source="Views/LiveViewer.xaml"/>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="3" Height="24">
            <StatusBarItem>
                <TextBlock x:Name="DbPathText" Text="" Foreground="Gray"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="RunStateText" Text="" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
